# NiftyPulse configuration. Copy to .env and edit.

# Server
HOST=127.0.0.1
PORT=8000

# Start on the simulated feed (safe, works outside market hours)
DEMO_MODE=0

# Automatically execute qualifying signals
AUTO_TRADE=1

# Risk
CAPITAL=500000
RISK_PER_TRADE_PCT=1.5

# Broker: paper | kite
BROKER=paper

# Real orders require ALL of: ENABLE_LIVE_TRADING=1, BROKER=kite, KITE_API_KEY, KITE_ACCESS_TOKEN
ENABLE_LIVE_TRADING=0
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# Optional: one Postgres wallet shared by this machine and Render.
# Use the same external connection string locally and on Render.
# Without it, the wallet stays in data/niftypulse.db (Render Free resets it).
# WALLET_DATABASE_URL=postgresql://user:password@host/db?sslmode=require
